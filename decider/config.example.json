{
  "workspace": "example",
  "url": "https://joppa.example/mcp",
  "mcp_command": [
    "mcp-remote",
    "https://joppa.example/mcp"
  ],
  "runs_folder": "/path/to/project/.crew/decider-runs",
  "workflow": "/path/to/crew/decider/workflow.yaml",
  "selection": {
    "kind": "ac",
    "assignee": "",
    "data": {
      "stage": "to_decide"
    }
  },
  "children": {
    "kind": [
      "test"
    ]
  },
  "references": [
    "sources",
    "consumer"
  ],
  "related": {
    "limit": 1,
    "parent": {
      "kind": "requirement"
    }
  },
  "publication": {
    "file": "operations.json",
    "allowed_operations": [
      "save_object",
      "note",
      "archive_object"
    ],
    "create_kinds": [
      "source",
      "ac",
      "requirement",
      "test"
    ],
    "update_kinds": [
      "ac",
      "test",
      "task"
    ],
    "structure": {
      "create": {
        "ac": [
          "context_parent",
          "fresh_parent",
          "created"
        ],
        "requirement": [
          "fresh_parent"
        ],
        "test": [
          "created"
        ]
      },
      "move": {
        "ac": [
          "fresh_parent",
          "created"
        ],
        "test": [
          "created",
          "fresh_parent"
        ]
      },
      "note_created": true
    }
  },
  "vars": {
    "AUTHOR_MODEL": "claude-opus-5-5",
    "CRITIC_CODEX_MODEL": "gpt-6.2-sol",
    "CRITIC_SECOND_HARNESS": "claude-code",
    "CRITIC_SECOND_MODEL": "claude-sonnet-5-5",
    "BRAIN_ROOT": "/path/to/project/policies",
    "MANUALS_ROOT": "/path/to/project/manuals",
    "BRAIN_EXCLUDE": "obsolete",
    "REWORK_LIMIT": "1",
    "READY_STAGE": "to_audit",
    "NEW_STAGE": "to_decide",
    "RETURNS_LIMIT": "3",
    "STUCK_TAG": "stuck",
    "CTO_TAG": "source-gap-cto",
    "CEO_TAG": "source-gap-ceo",
    "DRY_RUN": "true",
    "ARCHIVE_HOOK": "bun /path/to/crew/decider/archive-hook.mjs",
    "ARCHIVE_LANE_CONFIG": "/path/to/project/dolber.json",
    "ARCHIVE_STOP_SECONDS": "30"
  },
  "concurrency": 6,
  "retry": "always",
  "exclude_tags": [
    "source-gap-cto",
    "source-gap-ceo",
    "manual-check",
    "stuck"
  ],
  "context": {
    "url": "https://joppa.example/api/data",
    "workspace": "example",
    "token_file": "/path/to/project/read-key",
    "roles": {
      "decider": {
        "role": "decider",
        "process": "decider",
        "kind": "process"
      },
      "audit": {
        "role": "ac-auditor",
        "process": "ac-auditor",
        "kind": "process"
      }
    },
    "session": {
      "kind": [
        "process",
        "rule"
      ],
      "fields": [
        "title",
        "body",
        "ends_when"
      ],
      "max_chars": 32768
    }
  }
}
