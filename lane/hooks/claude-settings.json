{
  "language": "english",
  "includeCoAuthoredBy": false,
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.cache/skk-cbm"
      ]
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(*git *)",
      "Bash(*bun *)",
      "Bash(*ntk *)",
      "Bash(*agentbus *)",
      "Bash(*medulla *)",
      "Bash(*grep *)",
      "Bash(*cd *)",
      "Bash(*echo *)",
      "Bash(*set -e*)",
      "Bash(*command -v *)",
      "Bash(*bash -n *)"
    ],
    "deny": [
      "mcp__ntk__ntk_update",
      "mcp__ntk__ntk_close",
      "mcp__ntk__ntk_create",
      "mcp__ntk__ntk_rm",
      "Bash(*git push*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f *)",
      "Bash(*git push --force-with-lease*)",
      "Bash(*git push --delete*)",
      "Bash(*git push -d *)",
      "Bash(*git push --mirror*)",
      "Bash(*gcloud builds submit*)",
      "Bash(*gcloud builds triggers run*)",
      "Bash(*gcloud builds triggers create*)",
      "Bash(*gcloud run deploy*)",
      "Bash(*gcloud run services update*)",
      "Bash(*gcloud run services replace*)",
      "Bash(*gcloud run jobs execute*)",
      "Bash(*deploy.sh*)",
      "Bash(*cloudbuild-deploy*)",
      "Bash(*cloudbuild-publish*)",
      "Bash(*schema-cutover*)",
      "Bash(*deploy-helpers.sh*)",
      "Bash(*tofu*apply*)",
      "Bash(*tofu*destroy*)",
      "Bash(*tofu*refresh*)",
      "Bash(*tofu*import*)",
      "Bash(*tofu*state*)",
      "Bash(*tofu*taint*)",
      "Bash(*tofu*workspace*)",
      "Bash(*tofu*force-unlock*)",
      "Bash(*tofu*login*)",
      "Bash(*tofu*logout*)",
      "Bash(*terraform *)",
      "mcp__agentbus__topics_prune"
    ]
  },
  "env": {
    "PATH": "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash <TOOLING_ROOT>/lane/hooks/memory-hook.sh",
            "timeout": 600,
            "statusMessage": "Loading Equill contract"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash <TOOLING_ROOT>/lane/hooks/memory-hook.sh",
            "timeout": 45,
            "statusMessage": "Retrieving relevant Equill memory"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash <TOOLING_ROOT>/lane/hooks/memory-hook.sh",
            "timeout": 20,
            "statusMessage": "Refreshing Equill memory"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash <TOOLING_ROOT>/lane/hooks/memory-hook.sh",
            "timeout": 20,
            "statusMessage": "Refreshing Equill memory"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash <TOOLING_ROOT>/lane/hooks/memory-hook.sh",
            "timeout": 20,
            "statusMessage": "Refreshing Equill memory"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
