# Скопируйте в lane/local.env и впишите свои значения.
# Файл читается run.sh и в репозиторий не попадает.

# Куда докладывать об успехе и падении. Пусто - полоса не докладывает никому.
TELEGRAM_ROOM=
TELEGRAM_TOPIC=

# Куда эскалировать и кому. Пусто - падение останется только в журнале прогона.
ESCALATION_ROOM=
ESCALATION_COURIER=

# Комната и разрешённые получатели для моста шины.
LANE_BUS_ROOM=
LANE_BUS_ALLOWED=
