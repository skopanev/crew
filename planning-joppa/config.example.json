{
  "workspace": "product",
  "url": "https://joppa.example.com/mcp",
  "token_file": "/path/to/private/planner.token",
  "reader_token_file": "/path/to/private/planner-reader.token",
  "runs_folder": "/path/to/private/planning-runs",
  "worktree_root": "/path/to/source-root/.worktrees",
  "lane_runs_folder": "/path/to/lane-state/crew-dispatchers/dispatcher-id/runs",
  "cbm_store": "/path/to/shared/cbm-store",
  "cbm_root": "/path/to/source-root",
  "equill_store": "/path/to/equill-store",
  "repositories": [
    {
      "id": "service",
      "project": "project:service-project-id",
      "path": "/path/to/source-root/service",
      "cbm_project": "service-index",
      "modules": [{"name": "feature", "path": "src/feature"}]
    }
  ]
}
